# Public site URL (used for metadata, sitemap and Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://smokex.vercel.app

# Contact form delivery via Resend (https://resend.com). Server-side only — never prefix with NEXT_PUBLIC_.
# If RESEND_API_KEY is not set, the form tells visitors it is not connected and offers a pre-filled email instead.
RESEND_API_KEY=
# Inbox that receives project inquiries.
CONTACT_TO_EMAIL=marellashanmukhareddy@gmail.com
# Verified sender in Resend. "onboarding@resend.dev" only delivers to the Resend account owner's own address.
CONTACT_FROM_EMAIL=SMOKE X <onboarding@resend.dev>

# Optional: GitHub token to raise the API rate limit for the repository section (read-only, no scopes needed).
GITHUB_TOKEN=
